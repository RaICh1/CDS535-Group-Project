{
  "weka_version": "3.8.7",
  "filters": "weka.filters.MultiFilter -F \"weka.filters.unsupervised.attribute.ReplaceMissingValues\" -F \"weka.filters.unsupervised.attribute.NominalToBinary\" -F \"weka.filters.unsupervised.attribute.RemoveUseless -M 100.0\" -F \"weka.filters.unsupervised.attribute.Standardize\"",
  "classifiers": {
    "J48": [
      "weka.classifiers.trees.J48",
      [
        "-C",
        "0.25",
        "-M",
        "2"
      ]
    ],
    "RandomForest": [
      "weka.classifiers.trees.RandomForest",
      [
        "-I",
        "200",
        "-S",
        "535",
        "-num-slots",
        "1"
      ]
    ],
    "Logistic": [
      "weka.classifiers.functions.Logistic",
      [
        "-R",
        "1.0E-8",
        "-M",
        "1000"
      ]
    ],
    "SMO": [
      "weka.classifiers.functions.SMO",
      [
        "-C",
        "1.0",
        "-N",
        "2",
        "-M",
        "-K",
        "weka.classifiers.functions.supportVector.RBFKernel -G 0.01"
      ]
    ]
  },
  "seed": 535,
  "positive_class_index": 1,
  "cv_note": "Weka creates stratified folds on the same development records; these are not the identical Python fold assignments. Metrics are Weka pooled CV results, rounded by its text output."
}